{
  "name": "workout_log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build --mode production",
    "start": "NODE_ENV=production node dist/server/index.js",
    "deploy:frontend": "npm run build:client && aws s3 sync dist/ s3://workout-log-frontend --delete --cache-control max-age=31536000,public",
    "deploy:backend": "eb deploy",
    "lint": "eslint .",
    "preview": "vite preview",
    "migrate": "tsx server/migrations/runner.ts migrate",
    "migrate:rollback": "tsx server/migrations/runner.ts rollback",
    "migrate:status": "tsx server/migrations/runner.ts status",
    "migrate:create": "tsx server/migrations/create.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:client": "vitest run --config vitest.config.ts",
    "test:server": "vitest run --config vitest.config.server.ts",
    "backup:test": "./scripts/restore-test.sh",
    "backup:test:all": "./scripts/restore-test.sh --all",
    "backup:test:local": "./scripts/restore-test.sh --file"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/web-push": "^3.6.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "pino": "^10.2.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.3.7",
    "jsdom": "^27.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
